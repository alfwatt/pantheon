# House layout: the single source of truth for how C, Objective-C
# and C++ source is laid out.  Kept in the tidy skill
# (~/.claude/skills/tidy/house.clang-format) and copied verbatim into
# each project as .clang-format.  The c-style-guide skill covers
# naming, API shape and documentation, and defers all layout to this
# file: if the output looks wrong, change this file, not the code.
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never

# K&R for control statements and functions, but `else`/`else if` on
# its own line at the `if`'s indent.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: false
  AfterControlStatement: false
  AfterEnum: false
  AfterStruct: false
  AfterUnion: false
  AfterCaseLabel: false
  BeforeElse: true

# Star binds to the type: char *key -> char* key, and the error
# out-param spells lit_error* _Nullable* _Nullable error.
PointerAlignment: Left
DerivePointerAlignment: false

# Prose blocks and glyph tables are hand-aligned; leave their breaks.
ReflowComments: false

ColumnLimit: 100

# #define values align in a column.
AlignConsecutiveMacros: AcrossComments
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignEscapedNewlines: Left

# Hanging chains lead with the operator, aligned under the start of
# the condition: `&& b`, `|| c`, `? x`, `: y`.
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeTernaryOperators: true
AlignOperands: Align

# Casts are spelled (type) value.
SpaceAfterCStyleCast: true

# Include order (own header, stdlib, POSIX, frameworks, vendored) is
# deliberate; see c-style-guide Headers and includes.
SortIncludes: false

# All control statements are braced, even one-statement bodies;
# the braced body sits on its own lines.
InsertBraces: true
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Empty

IndentCaseLabels: false
KeepEmptyLinesAtTheStartOfBlocks: false
